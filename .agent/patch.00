+    private suspend fun syncCompletedSessionLoads(completedSets: List<SessionSetEntity>) {
+        completedSets
+            .filter { it.loadKg.isFinite() && it.loadKg > 0.0 }
+            .groupBy(SessionSetEntity::exerciseId)
+            .forEach { (exerciseId, exerciseSets) ->
+                val eligible = exerciseSets.filter { set ->
+                    dao.workoutExercise(set.workoutExerciseId)?.exerciseId == exerciseId
+                }
+                if (eligible.isEmpty()) return@forEach
+                // Prefer the first completed working set. This matches the default propagated load;
+                // if it is unavailable, use the most frequent load and break ties by the heaviest.
+                val firstLoad = eligible.minByOrNull(SessionSetEntity::setNumber)?.loadKg
+                val representative = firstLoad?.takeIf { it > 0.0 } ?: eligible
