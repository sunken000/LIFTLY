+    suspend fun setSupersetPair(workoutId: String, firstId: String, secondId: String, enabled: Boolean) = database.withTransaction {
+        val ordered = normalizedWorkoutExercises(workoutId)
+        val firstIndex = ordered.indexOfFirst { it.id == firstId }
+        val secondIndex = ordered.indexOfFirst { it.id == secondId }
+        require(firstIndex >= 0 && secondIndex == firstIndex + 1) { "O bi-set precisa usar dois exercícios consecutivos." }
+
+        val updated = ordered.mapIndexed { index, item ->
+            when {
+                item.id == firstId || item.id == secondId -> item.copy(setType = if (enabled) "Supersérie" else "Normal")
+                enabled && index == firstIndex - 1 && item.setType.isSupersetType() -> item.copy(setType = "Normal")
+                enabled && index == secondIndex + 1 && item.setType.isSupersetType() -> item.copy(setType = "Normal")
+                else -> item
+            }
+        }
+        dao.upsertWorkoutExercises(updated)
+    }
+
